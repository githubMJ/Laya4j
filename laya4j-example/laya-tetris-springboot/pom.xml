<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.laya4j.examples</groupId>
    <artifactId>laya-tetris-springboot</artifactId>
    <version>0.1.0</version>
    <name>laya-tetris-springboot</name>
    <description>
        Spring Boot 示例:用 Laya(com.laya4j:laya4j-core)的 choice/score/noul
        三种决策原语驱动俄罗斯方块的落子决策,并通过 Web 页面实时展示决策轨迹。
        本模块不属于 Laya4j 发布库,仅作为独立可运行的集成测试/演示工程。
    </description>

    <properties>
        <java.version>17</java.version>
        <!-- 本项目 parent 是 spring-boot-starter-parent,属性不经过 laya4j-example 传递,
             版本需与此处及 laya4j-core/pom.xml 保持一致 -->
        <laya4j-core.version>0.2.0</laya4j-core.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.laya4j</groupId>
            <artifactId>laya4j-core</artifactId>
            <version>${laya4j-core.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
