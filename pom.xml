<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.laya4j</groupId>
    <artifactId>laya4j-parent</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>

    <name>Laya4j Parent</name>
    <description>Parent/aggregator for Laya4j modules. The published library lives in laya4j-core/.</description>
    <url>https://github.com/aidenma/Laya4j</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>aidenma</id>
            <name>aidenma</name>
            <email>aidenma@tencent.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/aidenma/Laya4j.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:aidenma/Laya4j.git</developerConnection>
        <url>https://github.com/aidenma/Laya4j</url>
    </scm>

    <modules>
        <module>laya4j-core</module>
        <module>laya4j-example</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <onnxruntime.version>1.30.0</onnxruntime.version>
        <djl.version>0.30.0</djl.version>
        <!-- Skip deploy of test/sample resources to Central -->
        <skipDeployTests>true</skipDeployTests>
    </properties>

    <!-- 配置发布仓库(只是 metadata,不发布 ONNX 模型);由 laya4j-core 继承 -->
    <distributionManagement>
        <snapshotRepository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>central</id>
            <url>https://central.sonatype.com/repository/maven-releases/</url>
        </repository>
    </distributionManagement>
</project>
